{
  "name": "apply_patch",
  "display_name": "应用补丁",
  "description": "应用补丁修改文件。",
  "parameters": {
    "type": "object",
    "properties": {
      "patchText": {
        "type": "string",
        "description": "完整补丁文本。格式：*** Begin Patch；一个或多个文件操作；*** End Patch。Add File 每行内容必须以 + 开头；Update File 使用 @@ hunk，行以空格、- 或 + 开头；Delete File 删除文件。"
      }
    },
    "required": [
      "patchText"
    ]
  },
  "permission": "writes",
  "always_loaded": false,
  "load_policy": "group",
  "groups": [
    "dev"
  ]
}
