{
  "name": "task",
  "display_name": "子代理",
  "description": "启动子代理独立处理复杂任务。",
  "parameters": {
    "type": "object",
    "properties": {
      "description": {
        "type": "string",
        "description": "简短任务描述，用于进度展示。"
      },
      "prompt": {
        "type": "string",
        "description": "详细任务提示：必须含完整上下文、目标和输出要求（子代理看不到主对话历史）。"
      },
      "subagent_type": {
        "type": "string",
        "enum": [
          "explore",
          "general"
        ],
        "default": "general",
        "description": "子代理类型。"
      },
      "max_steps": {
        "type": "integer",
        "description": "工具调用预算上限；explore 默认 30，general 默认 50。"
      }
    },
    "required": [
      "description",
      "prompt"
    ]
  },
  "permission": "writes",
  "always_loaded": true,
  "load_policy": "summary",
  "groups": [
    "agent"
  ]
}
