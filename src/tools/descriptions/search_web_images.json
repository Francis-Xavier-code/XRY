{
  "name": "search_web_images",
  "display_name": "搜索图片",
  "description": "多来源并行搜索网络图片，统一排序去重并安全审核。",
  "parameters": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "description": "图片搜索关键词。"
      },
      "count": {
        "type": "integer",
        "description": "必填，最终返回图片的精确数量。"
      },
      "preview": {
        "type": "boolean",
        "description": "下载后用 chafa 预览图片。"
      },
      "preview_count": {
        "type": "integer",
        "description": "最多预览几张。"
      },
      "safe_search": {
        "type": "boolean",
        "description": "启用安全搜图，默认用插件配置。"
      }
    },
    "required": [
      "query",
      "count"
    ]
  },
  "permission": "readonly",
  "always_loaded": false,
  "load_policy": "summary",
  "groups": [
    "images"
  ]
}
