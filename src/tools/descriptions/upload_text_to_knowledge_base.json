{
  "name": "upload_text_to_knowledge_base",
  "display_name": "导入知识库",
  "description": "把文本上传进知识库。",
  "parameters": {
    "type": "object",
    "properties": {
      "content": {
        "type": "string",
        "description": "文本内容。"
      },
      "title": {
        "type": "string",
        "description": "Optional title used for markdown heading and default file name."
      },
      "file_name": {
        "type": "string",
        "description": "Optional knowledge base relative path."
      }
    },
    "required": [
      "content"
    ]
  },
  "permission": "writes",
  "always_loaded": false,
  "load_policy": "group",
  "groups": [
    "knowledge-admin"
  ]
}
