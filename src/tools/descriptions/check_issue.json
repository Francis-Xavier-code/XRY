{
  "name": "check_issue",
  "display_name": "检查问题",
  "description": "收集本地问题诊断证据（只读，不诊断不修复）。",
  "parameters": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "description": "用户原始问题，用于自动推断范围。"
      },
      "area": {
        "type": "string",
        "enum": [
          "auto",
          "system",
          "app",
          "input_method",
          "display",
          "audio",
          "package",
          "gpu",
          "network",
          "storage"
        ]
      },
      "target": {
        "type": "string",
        "description": "可选目标应用/进程/命令/包/子系统。"
      },
      "symptom": {
        "type": "string",
        "description": "可选症状标签。"
      },
      "depth": {
        "type": "string",
        "enum": [
          "quick",
          "normal",
          "full"
        ]
      },
      "recent_minutes": {
        "type": "integer",
        "description": "日志窗口分钟数（1..1440）。"
      },
      "platform": {
        "type": "string",
        "enum": [
          "auto",
          "linux",
          "macos"
        ]
      },
      "allow_launch_probe": {
        "type": "boolean",
        "description": "允许启动目标采集运行时信息。"
      },
      "launch_timeout_seconds": {
        "type": "integer",
        "description": "启动后等待秒数，默认 3，最大 15。"
      }
    },
    "required": []
  },
  "permission": "readonly",
  "always_loaded": false,
  "load_policy": "group",
  "groups": [
    "diagnostics"
  ]
}
