{
  "name": "print_image",
  "display_name": "显示图片",
  "description": "用 chafa 在终端直接渲染本地图片。",
  "parameters": {
    "type": "object",
    "properties": {
      "image": {
        "type": "string",
        "description": "本地图片路径。"
      },
      "size": {
        "type": "string",
        "description": "可选 chafa 尺寸，如 80x40。"
      },
      "width": {
        "type": "integer",
        "description": "终端单元格输出宽度，如 80。"
      },
      "height": {
        "type": "integer",
        "description": "终端单元格输出高度，如 40。"
      }
    },
    "required": [
      "image"
    ]
  },
  "permission": "readonly",
  "always_loaded": false,
  "load_policy": "group",
  "groups": [
    "images"
  ]
}
