{
  "name": "get_weather",
  "display_name": "天气查询",
  "description": "查询气象数据。query_type 指定类型（forecast 天气/空气、historical 历史、marine 海洋、climate 气候、elevation 海拔），默认 forecast。location 传城市、邮编或机场码，空=自动定位。days 预报天数默认 3。start_date/end_date 用于 historical/climate。country_code 可选 ISO 国家码消歧。",
  "parameters": {
    "type": "object",
    "properties": {
      "location": {
        "type": "string",
        "description": "城市、邮编或机场码；空=自动定位。"
      },
      "query_type": {
        "type": "string",
        "enum": [
          "forecast",
          "air_quality",
          "historical",
          "marine",
          "climate",
          "elevation"
        ]
      },
      "days": {
        "type": "integer",
        "description": "预报天数，默认 3，最大 7。"
      },
      "start_date": {
        "type": "string",
        "description": "开始日期 YYYY-MM-DD（historical/climate）。"
      },
      "end_date": {
        "type": "string",
        "description": "结束日期 YYYY-MM-DD（historical/climate）。"
      },
      "country_code": {
        "type": "string",
        "description": "ISO 国家码消歧，如 CN、JP。"
      }
    }
  },
  "permission": "readonly",
  "always_loaded": true,
  "load_policy": "summary",
  "groups": [
    "web"
  ]
}
